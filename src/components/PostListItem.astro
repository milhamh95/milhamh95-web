---
// Look adapted from reference/astrowind/src/components/blog/ListItem.astro:
// image left (when present), text right, roughly 50/50 like AstroWind's own
// desktop list. Falls back to text-only cleanly.
import { Image } from "astro:assets";
import { formatDate, getReadingTime } from "../lib/posts";
import type { CollectionEntry } from "astro:content";
import techDefault from "../assets/category-defaults/dev-notes.png";
import offTopicDefault from "../assets/category-defaults/off-topics.png";

const CATEGORY_DEFAULTS = { "dev-notes": techDefault, "off-topic": offTopicDefault };

interface Props {
  post: CollectionEntry<"blog">;
}

const { post } = Astro.props;
const { title, description, pubDate, tags, heroImage, category } = post.data;
const href = `/blog/${post.id}`;
const image = heroImage ?? CATEGORY_DEFAULTS[category];
---

<article class="grid gap-6 sm:grid-cols-[3fr_5fr]">
  {/* self-start: without it, the grid row stretches this to match the text
     column's height, so a longer description made the image taller too.
     aspect-[4/3] keeps every thumbnail the same shape regardless of
     description length — taller than the detail page's 16:9-ish banner
     since this column is only about half the page width, not the full one.
     bg-[#313244] (ctp-mocha surface0), not the swapping bg-surface0 token:
     the category default PNGs have a transparent background designed for a
     dark backdrop, so their light text/icons disappear against Latte's light
     surface0 — same fixed-Mocha reasoning as code blocks in global.css. */}
  <a href={href} class="block self-start overflow-hidden rounded-lg bg-[#313244] shadow-lg">
    <Image src={image} alt="" width={336} height={252} class="aspect-[4/3] w-full object-cover" />
  </a>
  <div>
    <div class="flex flex-col gap-1 text-sm text-subtext0">
      <span class="flex items-center gap-1.5">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-3.5 shrink-0">
          <rect width="18" height="18" x="3" y="4" rx="2" ry="2" /><path d="M16 2v4M8 2v4M3 10h18" />
        </svg>
        {formatDate(pubDate)}
      </span>
      <span class="flex items-center gap-1.5">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-3.5 shrink-0">
          <circle cx="12" cy="12" r="10" /><path d="M12 6v6l4 2" />
        </svg>
        {getReadingTime(post)}
      </span>
    </div>
    <h2 class="mt-1 text-xl lg:text-2xl font-semibold text-text">
      <a href={href} class="hover:text-accent">{title}</a>
    </h2>
    <p class="mt-1 text-justify text-subtext0 lg:text-lg">{description}</p>
    {tags.length > 0 && (
      <div class="mt-2 flex flex-wrap gap-2">
        {tags.map((tag) => (
          <a href={`/tags/${tag}`} class="rounded-full bg-crust dark:bg-surface0 px-2.5 py-0.5 text-sm text-subtext1 hover:text-accent">
            #{tag}
          </a>
        ))}
      </div>
    )}
  </div>
</article>
