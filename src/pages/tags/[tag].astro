---
import Layout from "../../layouts/Layout.astro";
import PostListItem from "../../components/PostListItem.astro";
import { getPublishedPosts } from "../../lib/posts";

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  const tags = new Set(posts.flatMap((post) => post.data.tags));
  return [...tags].map((tag) => ({
    params: { tag },
    props: { posts: posts.filter((post) => post.data.tags.includes(tag)) },
  }));
}

const { tag } = Astro.params;
const { posts } = Astro.props;
---

<Layout title={`#${tag} | milhamh.com`} description={`Posts tagged #${tag}.`}>
  <section class="mx-auto max-w-2xl px-4 py-16">
    <a href="/tags" class="text-sm text-subtext0 hover:text-accent">&larr; All tags</a>
    <h1 class="mt-2 text-2xl font-semibold text-text">#{tag}</h1>
    <div class="mt-8 flex flex-col gap-8">
      {posts.map((post) => <PostListItem post={post} />)}
    </div>
  </section>
</Layout>
