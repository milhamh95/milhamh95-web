---
import Layout from "../layouts/Layout.astro";
---

<Layout title="About | milhamh.com" description="About Muhammad Ilham Hidayat.">
  <section class="mx-auto max-w-2xl px-4 py-16">
    <h1 class="text-2xl font-semibold text-text">About</h1>
    <div class="prose prose-sm mt-4 max-w-none text-subtext0">
      <p>
        I'm Muhammad Ilham Hidayat, a software engineer. This is my personal site, where I write
        about the things I build and learn.
      </p>
      <p>
        Find me on <a class="text-accent underline underline-offset-4 hover:no-underline" href="https://github.com/milhamh95" target="_blank" rel="noopener noreferrer">GitHub</a>.
      </p>
    </div>
  </section>
</Layout>
