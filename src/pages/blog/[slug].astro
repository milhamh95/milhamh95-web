---
import { getCollection, render } from "astro:content";
import { Image } from "astro:assets";
import Layout from "../../layouts/Layout.astro";
import { formatDate } from "../../lib/posts";

export async function getStaticPaths() {
  // Drafts get a page in `npm run dev` (import.meta.env.DEV), so you can preview
  // at its real URL before publishing — but `npm run build` (what actually ships)
  // never generates the page at all, so a draft is a 404 in production, not just
  // hidden from lists. Set `draft: false` in the post's frontmatter to publish it.
  const posts = await getCollection("blog", ({ data }) => !data.draft || import.meta.env.DEV);
  // post.id is single-segment (e.g. "hello-world"): glob() strips a trailing
  // "/index" from folder-per-post files, so this only works because every post
  // lives at `<slug>/index.md`, not nested deeper.
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { title, description, pubDate, updatedDate, tags, heroImage, draft } = post.data;
const { Content } = await render(post);
---

<Layout title={`${title} | milhamh.com`} description={description} ogSlug={post.id}>
  <article class="mx-auto max-w-2xl px-4 py-16">
    {draft && (
      <p class="mb-4 inline-block rounded-full bg-yellow px-2.5 py-0.5 text-xs font-medium text-crust">
        Draft &mdash; not published, dev preview only
      </p>
    )}
    <p class="text-xs text-subtext0">
      {formatDate(pubDate)}
      {updatedDate && <span> &middot; updated {formatDate(updatedDate)}</span>}
    </p>
    <h1 class="mt-1 text-3xl font-semibold text-text">{title}</h1>

    {tags.length > 0 && (
      <div class="mt-3 flex flex-wrap gap-2">
        {tags.map((tag) => (
          <a href={`/tags/${tag}`} class="rounded-full bg-surface0 px-2.5 py-0.5 text-xs text-subtext1 hover:text-accent">
            #{tag}
          </a>
        ))}
      </div>
    )}

    {heroImage && (
      <Image src={heroImage} alt="" width={896} height={480} class="mt-8 w-full rounded-lg object-cover" />
    )}

    <div class="prose prose-sm mt-8 max-w-none">
      <Content />
    </div>
  </article>
</Layout>
