---
import { getCollection, render } from "astro:content";
import { Image } from "astro:assets";
import Layout from "../../layouts/Layout.astro";
import { formatDate, getReadingTime } from "../../lib/posts";
import techDefault from "../../assets/category-defaults/dev-notes.png";
import offTopicDefault from "../../assets/category-defaults/off-topics.png";

const CATEGORY_DEFAULTS = { "dev-notes": techDefault, "off-topic": offTopicDefault };

export async function getStaticPaths() {
  // Drafts get a page in `npm run dev` (import.meta.env.DEV), so you can preview
  // at its real URL before publishing — but `npm run build` (what actually ships)
  // never generates the page at all, so a draft is a 404 in production, not just
  // hidden from lists. Set `draft: false` in the post's frontmatter to publish it.
  const posts = await getCollection("blog", ({ data }) => !data.draft || import.meta.env.DEV);
  // post.id is single-segment (e.g. "hello-world"): glob() strips a trailing
  // "/index" from folder-per-post files, so this only works because every post
  // lives at `<slug>/index.md`, not nested deeper.
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { title, description, pubDate, updatedDate, tags, heroImage, category, draft } = post.data;
const image = heroImage ?? CATEGORY_DEFAULTS[category];
const { Content, headings } = await render(post);
// h2 only: h1 is the post title above, and h3+ makes scroll-highlighting ambiguous
// when two subheadings sit close together.
const tocHeadings = headings.filter((h) => h.depth === 2);
---

<Layout title={`${title} | milhamh.com`} description={description} ogSlug={post.id}>
  <div class="mx-auto max-w-5xl px-4 py-16 lg:grid lg:grid-cols-[minmax(0,48rem)_14rem] lg:justify-between lg:gap-12">
  <article class="max-w-3xl">
    {draft && (
      <p class="mb-4 inline-block rounded-full bg-blue-strong px-2.5 py-0.5 text-sm font-medium text-crust">
        Draft &mdash; not published, dev preview only
      </p>
    )}
    <div class="flex flex-col gap-1 text-sm text-subtext0">
      <span class="flex items-center gap-1.5">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-3.5 shrink-0">
          <rect width="18" height="18" x="3" y="4" rx="2" ry="2" /><path d="M16 2v4M8 2v4M3 10h18" />
        </svg>
        {formatDate(pubDate)}
        {updatedDate && <span>&middot; updated {formatDate(updatedDate)}</span>}
      </span>
      <span class="flex items-center gap-1.5">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-3.5 shrink-0">
          <circle cx="12" cy="12" r="10" /><path d="M12 6v6l4 2" />
        </svg>
        {getReadingTime(post)}
      </span>
    </div>
    <h1 class="mt-1 text-4xl font-semibold text-text">{title}</h1>

    {tags.length > 0 && (
      <div class="mt-3 flex flex-wrap gap-2">
        {tags.map((tag) => (
          <a href={`/tags/${tag}`} class="rounded-full bg-crust dark:bg-surface0 px-2.5 py-0.5 text-sm text-subtext1 hover:text-accent">
            #{tag}
          </a>
        ))}
      </div>
    )}

    {/* bg-[#313244] (ctp-mocha surface0), fixed regardless of site theme: the
       category default PNGs have a transparent background designed for a
       dark backdrop — see the matching comment in PostListItem.astro. */}
    <div class="mt-8 overflow-hidden rounded-lg bg-[#313244]">
      <Image src={image} alt="" width={896} height={480} loading="eager" class="w-full object-cover" />
    </div>

    <div class="prose lg:prose-lg mt-8 max-w-none">
      <Content />
    </div>
  </article>

  {tocHeadings.length > 0 && (
    <>
    <aside class="hidden lg:block">
      <nav aria-label="Table of contents" class="sticky top-24">
        <p class="text-sm font-semibold text-text">On this page</p>
        <ul class="mt-3 space-y-2 border-l border-surface0 text-sm">
          {tocHeadings.map((h) => (
            <li class="-ml-px border-l-2 border-transparent">
              <a href={`#${h.slug}`} class="block py-0.5 pl-3 text-subtext0 hover:text-accent">
                {h.text}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </aside>

    {/* Highlights the TOC link for whichever section fills the most of the
       viewport right now. A "last heading whose top passed the header" check
       (an earlier version of this script) breaks for short trailing sections:
       on a tall viewport, a short last section may never reach the top before
       the page runs out of room to scroll, so it never lights up. Overlap
       with the actual visible area is correct regardless of viewport size or
       section length. */}
    <script is:inline>
      const tocLinks = [...document.querySelectorAll('nav[aria-label="Table of contents"] a')];
      const headingEls = tocLinks
        .map((a) => document.getElementById(a.getAttribute('href').slice(1)))
        .filter(Boolean);

      const HEADER_OFFSET = 96; // area hidden behind the sticky header doesn't count as "visible"

      const setActive = () => {
        const viewTop = window.scrollY + HEADER_OFFSET;
        const viewBottom = window.scrollY + window.innerHeight;

        let current = headingEls[0];
        let bestOverlap = -Infinity;
        headingEls.forEach((el, i) => {
          const sectionStart = el.getBoundingClientRect().top + window.scrollY;
          const sectionEnd =
            i + 1 < headingEls.length
              ? headingEls[i + 1].getBoundingClientRect().top + window.scrollY
              : document.documentElement.scrollHeight;
          const overlap = Math.min(viewBottom, sectionEnd) - Math.max(viewTop, sectionStart);
          if (overlap > bestOverlap) {
            bestOverlap = overlap;
            current = el;
          }
        });

        // Reaching the true bottom of the page always means "last section is
        // current" — even if an earlier, taller section still covers more of
        // a large screen and would otherwise win the overlap comparison.
        const atBottom = viewBottom >= document.documentElement.scrollHeight - 2;
        if (atBottom) current = headingEls[headingEls.length - 1];

        tocLinks.forEach((a) => {
          const isActive = a.getAttribute('href') === `#${current?.id}`;
          // classList.toggle() alone doesn't work here: Tailwind's cascade order
          // has .text-subtext0/.border-transparent declared after .text-accent/
          // .border-accent, so the default class wins even while the active
          // class is also present. Swap them explicitly instead of stacking.
          a.classList.toggle('text-accent', isActive);
          a.classList.toggle('text-subtext0', !isActive);
          a.parentElement.classList.toggle('border-accent', isActive);
          a.parentElement.classList.toggle('border-transparent', !isActive);
        });
      };

      // Listen on window, not document: the scroll event only reliably fires
      // there for a whole-page scroll (this was the earlier "stuck highlight" bug).
      let ticking = false;
      window.addEventListener(
        'scroll',
        () => {
          if (ticking) return;
          ticking = true;
          requestAnimationFrame(() => {
            setActive();
            ticking = false;
          });
        },
        { passive: true },
      );
      setActive();
    </script>
    </>
  )}
  </div>
</Layout>
