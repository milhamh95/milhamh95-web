---
import type { GetStaticPaths } from "astro";
import Layout from "../../layouts/Layout.astro";
import PaginatedPostList from "../../components/PaginatedPostList.astro";
import PostSearch from "../../components/PostSearch.astro";
import { getPublishedPosts } from "../../lib/posts";

export const getStaticPaths = (async ({ paginate }) => {
  const pageSize = 5;
  const maxPages = 6;
  const posts = await getPublishedPosts();
  return paginate(posts.slice(0, pageSize * maxPages), { pageSize });
}) satisfies GetStaticPaths;

const { page } = Astro.props;
---

<Layout title="Blog | milhamh.com" description="All posts.">
  <section class="mx-auto w-full max-w-5xl px-4 py-16">
    <h1 class="text-3xl font-semibold text-text">Blog</h1>
    <PostSearch />
    <PaginatedPostList page={page} />
  </section>
</Layout>
