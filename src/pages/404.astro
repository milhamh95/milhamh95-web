---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Page not found | milhamh.com">
  <section class="mx-auto flex max-w-5xl flex-col items-center px-4 py-24 text-center">
    <p class="font-medium text-accent">404</p>
    <h1 class="mt-2 text-3xl font-semibold text-text">Page not found</h1>
    <p class="mt-3 text-subtext0">The page you're looking for doesn't exist or moved.</p>
    <a href="/" class="mt-6 text-accent underline underline-offset-4 hover:no-underline">
      &larr; Back home
    </a>
  </section>
</Layout>
