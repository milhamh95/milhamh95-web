---
import type { GetStaticPaths } from "astro";
import Layout from "../../../layouts/Layout.astro";
import PaginatedPostList from "../../../components/PaginatedPostList.astro";
import PostSearch from "../../../components/PostSearch.astro";
import { getPublishedPosts } from "../../../lib/posts";

const LABELS = { "dev-notes": "Dev Notes", "off-topic": "Off Topics" } as const;

export const getStaticPaths = (async ({ paginate }) => {
  const posts = await getPublishedPosts();
  const categories = [...new Set(posts.map((post) => post.data.category))];
  return categories.flatMap((category) =>
    paginate(
      posts.filter((post) => post.data.category === category),
      { pageSize: 5, params: { category } },
    ),
  );
}) satisfies GetStaticPaths;

const { category } = Astro.params as { category: keyof typeof LABELS };
const { page } = Astro.props;
const label = LABELS[category];
---

<Layout title={`${label} | milhamh.com`} description={`Posts in ${label}.`}>
  <section class="mx-auto w-full max-w-5xl px-4 py-16">
    <h1 class="text-3xl font-semibold text-text">{label}</h1>
    <PostSearch category={category} placeholder={`Search ${label} by title…`} />
    <PaginatedPostList page={page} />
  </section>
</Layout>
